# Database
DATABASE_URL="postgresql://mac@localhost:5432/interview_insights_dev?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-change-in-production-min-32-chars"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Provider Adapter
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""

# Object Storage (S3 compatible)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET_NAME="interview-insights-transcripts"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Flutterwave Billing
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# App Configuration
NODE_ENV="development"
PORT=3000
